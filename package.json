    "prisma8:plan": "prisma migration plan --config ./prisma8.config.ts",
    "prisma8:db": "prisma db --config ./prisma8.config.ts",
    "start:mac": "./start.sh",
    "start:mac:verify": "./start.sh --verify-only",
    "purge:modules": "tsx scripts/purge_standalone.ts",
    "verify:backend": "tsx scripts/verify_backend.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "lucide-react": "1.55.0",
